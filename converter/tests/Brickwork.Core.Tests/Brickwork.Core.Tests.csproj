    </None>
    <None Include="..\..\..\resources\map-with-mass-edits.ink" Link="resources\map-with-mass-edits.ink">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\..\resources\The Pig and Whistle tavern.uvtt" Link="resources\The Pig and Whistle tavern.uvtt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\..\resources\fvtt-scene-basic-walls.json" Link="resources\fvtt-scene-basic-walls.json">
