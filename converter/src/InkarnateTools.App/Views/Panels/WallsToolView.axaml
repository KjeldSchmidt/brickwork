<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InkarnateTools.App.ViewModels"
             x:Class="InkarnateTools.App.Views.Panels.WallsToolView"
             x:DataType="vm:WallsToolViewModel">
    <Grid Margin="12">
        <TextBlock Text="Open a source map to list walls."
                   Opacity="0.6"
                   TextWrapping="Wrap"
                   IsVisible="{Binding ShowEmptyMessage}" />

        <TreeView x:Name="WallsTree"
                  ItemsSource="{Binding Layers}"
                  SelectedItem="{Binding SelectedTreeItem, Mode=TwoWay}"
                  IsVisible="{Binding HasLayers}">
            <TreeView.Styles>
                <!-- Expand every container as it materializes (nested groups aren't in the tree until parents expand). -->
                <Style Selector="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True" />
                </Style>
            </TreeView.Styles>
            <TreeView.DataTemplates>
                <TreeDataTemplate DataType="vm:WallLayerNodeViewModel"
                                  ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <CheckBox IsChecked="{Binding IsActive}"
                                  IsThreeState="True"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DisplayName}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </TreeDataTemplate>

                <TreeDataTemplate DataType="vm:WallGroupNodeViewModel"
                                  ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <CheckBox IsChecked="{Binding IsActive}"
                                  IsThreeState="True"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DisplayName}"
                                   FontWeight="Medium"
                                   Opacity="0.95"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </TreeDataTemplate>

                <TreeDataTemplate DataType="vm:WallItemViewModel"
                                  ItemsSource="{Binding Portals}">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsActive}"
                                  VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DisplayName}"
                                   VerticalAlignment="Center"
                                   Margin="6,0" />
                        <ComboBox Grid.Column="2"
                                  Width="90"
                                  ItemsSource="{Binding LineTypeOptions}"
                                  SelectedItem="{Binding LineType}" />
                    </Grid>
                </TreeDataTemplate>

                <DataTemplate DataType="vm:WallPortalItemViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,2,0,2">
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsActive}"
                                  VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DisplayName}"
                                   VerticalAlignment="Center"
                                   Margin="6,0"
                                   Opacity="0.85" />
                        <ComboBox Grid.Column="2"
                                  Width="90"
                                  ItemsSource="{Binding LineTypeOptions}"
                                  SelectedItem="{Binding LineType}" />
                    </Grid>
                </DataTemplate>
            </TreeView.DataTemplates>
        </TreeView>
    </Grid>
</UserControl>
