<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InkarnateTools.App.ViewModels"
             x:Class="InkarnateTools.App.Views.Panels.ImportToolView"
             x:DataType="vm:ImportToolViewModel">
    <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <Button Grid.Row="0"
                Margin="0,0,0,12"
                Content="Open source map"
                Command="{Binding OpenSourceMapCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />

        <StackPanel Grid.Row="1" Margin="0,0,0,12" Spacing="8">
            <TextBlock Text="Compatibility" FontWeight="SemiBold" />
            <TextBlock Text="{Binding CompatibilityMessage}"
                       TextWrapping="Wrap"
                       FontFamily="Consolas, Courier New, monospace"
                       Opacity="0.9" />
            <TextBlock Text="See the Debug panel for transaction details and source JSON export."
                       TextWrapping="Wrap"
                       Opacity="0.6"
                       FontSize="11" />
        </StackPanel>

        <Button Grid.Row="2"
                Margin="0,0,0,12"
                Content="Convert"
                Command="{Binding ConvertCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />

        <TextBlock Grid.Row="4"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Bottom"
                   Opacity="0.85" />
    </Grid>
</UserControl>
