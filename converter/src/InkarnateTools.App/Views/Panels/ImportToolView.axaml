<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InkarnateTools.App.ViewModels"
             x:Class="InkarnateTools.App.Views.Panels.ImportToolView"
             x:DataType="vm:ImportToolViewModel"
             Classes="tool-panel">
    <ScrollViewer Classes="tool-panel-scroll">
        <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto">
        <Button Grid.Row="0"
                Margin="0,0,0,12"
                Content="Open source map"
                Command="{Binding OpenSourceMapCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />

        <Button Grid.Row="1"
                Margin="0,0,0,12"
                Content="Convert"
                Command="{Binding ConvertCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Bottom"
                   Opacity="0.85" />
        </Grid>
    </ScrollViewer>
</UserControl>
