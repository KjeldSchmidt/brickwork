<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InkarnateTools.App.ViewModels"
             x:Class="InkarnateTools.App.Views.Panels.DebugToolView"
             x:DataType="vm:DebugToolViewModel">
    <Grid Margin="12" RowDefinitions="Auto,Auto">
        <StackPanel Grid.Row="0" Margin="0,0,0,12" Spacing="8">
            <TextBlock Text="Compatibility" FontWeight="SemiBold" />
            <SelectableTextBlock Text="{Binding CompatibilityMessage}"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas, Courier New, monospace"
                                 Opacity="0.9" />
            <Expander Header="Details"
                      IsVisible="{Binding HasCompatibilityDetails}"
                      IsExpanded="False">
                <ScrollViewer MaxHeight="280"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,8,0,0" Spacing="12">
                        <StackPanel Spacing="4" IsVisible="{Binding HasUnknownActions}">
                            <TextBlock Text="Unknown actions"
                                       FontWeight="SemiBold"
                                       Opacity="0.9" />
                            <SelectableTextBlock Text="{Binding CompatibilityUnknownActionsMessage}"
                                                 TextWrapping="Wrap"
                                                 FontFamily="Consolas, Courier New, monospace"
                                                 Opacity="0.9" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Transactions"
                                       FontWeight="SemiBold"
                                       Opacity="0.9" />
                            <SelectableTextBlock Text="{Binding CompatibilityTransactionsMessage}"
                                                 TextWrapping="Wrap"
                                                 FontFamily="Consolas, Courier New, monospace"
                                                 Opacity="0.9" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Expander>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Text="Source JSON" FontWeight="SemiBold" />
            <SelectableTextBlock Text="{Binding SourceJsonSummary}"
                                 TextWrapping="Wrap"
                                 Opacity="0.85" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Copy"
                        Command="{Binding CopySourceJsonCommand}"
                        MinWidth="88" />
                <Button Content="Save as..."
                        Command="{Binding SaveSourceJsonCommand}"
                        MinWidth="88" />
            </StackPanel>
            <SelectableTextBlock Text="{Binding SourceJsonStatus}"
                                 TextWrapping="Wrap"
                                 Opacity="0.85" />
        </StackPanel>
    </Grid>
</UserControl>
