<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dock="using:Dock.Avalonia.Themes.Fluent"
             xmlns:map="using:InkarnateTools.App.Views.Map"
             xmlns:panels="using:InkarnateTools.App.Views.Panels"
             xmlns:vm="using:InkarnateTools.App.ViewModels"
             x:Class="InkarnateTools.App.App"
             RequestedThemeVariant="Default">
    <Application.DataTemplates>
        <DataTemplate DataType="vm:ImportToolViewModel">
            <panels:ImportToolView />
        </DataTemplate>
        <DataTemplate DataType="vm:WallsToolViewModel">
            <panels:WallsToolView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsToolViewModel">
            <panels:SettingsToolView />
        </DataTemplate>
        <DataTemplate DataType="vm:MapPreviewDocumentViewModel">
            <map:MapPreviewDocumentView />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <dock:DockFluentTheme />
    </Application.Styles>
</Application>
