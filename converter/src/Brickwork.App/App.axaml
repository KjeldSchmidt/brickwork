<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dock="using:Dock.Avalonia.Themes.Fluent"
             xmlns:map="using:Brickwork.App.Views.Map"
             xmlns:panels="using:Brickwork.App.Views.Panels"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:vm="using:Brickwork.App.ViewModels"
             x:Class="Brickwork.App.App"
             RequestedThemeVariant="Dark">
    <Application.DataTemplates>
        <DataTemplate DataType="vm:ImportToolViewModel">
            <panels:ImportToolView />
        </DataTemplate>
        <DataTemplate DataType="vm:WallsToolViewModel">
            <panels:WallsToolView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsToolViewModel">
            <panels:SettingsToolView />
        </DataTemplate>
        <DataTemplate DataType="vm:MapPreviewDocumentViewModel">
            <map:MapPreviewDocumentView />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <semi:SemiTheme Locale="en-US" />
        <dock:DockFluentTheme />

        <Style Selector="ScrollViewer.tool-panel-scroll">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style Selector="ToolTabStrip">
            <Setter Property="Background" Value="#252830" />
        </Style>

        <Style Selector="ToolTabStripItem">
            <Setter Property="Foreground" Value="#B8C0CC" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="ToolTabStripItem TextBlock">
            <Setter Property="Foreground" Value="#B8C0CC" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="ToolTabStripItem ContentPresenter">
            <Setter Property="Foreground" Value="#B8C0CC" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="ToolTabStripItem /template/ Border">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="ToolTabStripItem:not(:selected) /template/ Border">
            <Setter Property="Background" Value="#353945" />
            <Setter Property="BorderBrush" Value="#4A5364" />
        </Style>

        <Style Selector="ToolTabStripItem:not(:selected) /template/ TextBlock">
            <Setter Property="Foreground" Value="#B8C0CC" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="ToolTabStripItem:selected /template/ Border">
            <Setter Property="Background" Value="#4A5364" />
            <Setter Property="BorderBrush" Value="#4A5364" />
        </Style>

        <Style Selector="ToolTabStripItem:selected /template/ TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="ToolTabStripItem:selected ContentPresenter">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style Selector="ToolTabStripItem:pointerover:not(:selected) /template/ Border">
            <Setter Property="Background" Value="#424957" />
            <Setter Property="BorderBrush" Value="#5A6478" />
        </Style>

        <Style Selector="ToolTabStripItem:pointerover:not(:selected) /template/ TextBlock">
            <Setter Property="Foreground" Value="#E2E8F0" />
        </Style>

        <Style Selector="DocumentTabStrip">
            <Setter Property="Background" Value="#252830" />
        </Style>

        <Style Selector="DocumentTabStripItem">
            <Setter Property="Foreground" Value="#B8C0CC" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="DocumentTabStripItem TextBlock">
            <Setter Property="Foreground" Value="#B8C0CC" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="DocumentTabStripItem ContentPresenter">
            <Setter Property="Foreground" Value="#B8C0CC" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="DocumentTabStripItem /template/ Border">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="DocumentTabStripItem:not(:selected) /template/ Border">
            <Setter Property="Background" Value="#353945" />
            <Setter Property="BorderBrush" Value="#4A5364" />
        </Style>

        <Style Selector="DocumentTabStripItem:not(:selected) /template/ TextBlock">
            <Setter Property="Foreground" Value="#B8C0CC" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="DocumentTabStripItem:selected /template/ Border">
            <Setter Property="Background" Value="#4A5364" />
            <Setter Property="BorderBrush" Value="#4A5364" />
        </Style>

        <Style Selector="DocumentTabStripItem:selected /template/ TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="DocumentTabStripItem:selected ContentPresenter">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style Selector="TreeViewItem">
            <Setter Property="Padding" Value="0,1" />
        </Style>

        <Style Selector="TreeViewItem > Grid > ContentPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Border.wall-tree-highlight">
            <Setter Property="Background" Value="#334488CC" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#3B82F6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#2563EB" />
        </Style>

        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2563EB" />
        </Style>

        <Style Selector="Button.muted">
            <Setter Property="Background" Value="#353945" />
            <Setter Property="Foreground" Value="#B8C0CC" />
            <Setter Property="BorderBrush" Value="#4A5364" />
        </Style>

        <Style Selector="Button.muted:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#424957" />
        </Style>
    </Application.Styles>
</Application>
