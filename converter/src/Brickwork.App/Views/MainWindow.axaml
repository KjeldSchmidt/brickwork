<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:vm="using:Brickwork.App.ViewModels"
        x:Class="Brickwork.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Brickwork"
        Icon="/Assets/app-icon.png"
        Width="1280"
        Height="800"
        MinWidth="800"
        MinHeight="600"
        WindowState="Maximized">
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenSourceMapCommand}" />
        <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportCommand}" />
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Classes="main-menu">
            <MenuItem Header="_File">
                <MenuItem Header="_Open…"
                          InputGesture="Ctrl+O"
                          HotKey="Ctrl+O"
                          Command="{Binding OpenSourceMapCommand}" />
                <MenuItem Header="_Export…"
                          InputGesture="Ctrl+E"
                          HotKey="Ctrl+E"
                          Command="{Binding ExportCommand}" />
                <MenuItem Header="_Settings…"
                          InputGesture="Ctrl+,"
                          HotKey="Ctrl+OemComma"
                          Command="{Binding OpenSettingsCommand}" />
                <Separator />
                <MenuItem Header="E_xit"
                          Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <!-- Shortcuts are handled in MainWindow.OnKeyDown so they also respect text-box focus. -->
                <MenuItem Header="{Binding UndoHeader}"
                          InputGesture="Ctrl+Z"
                          Command="{Binding UndoCommand}" />
                <MenuItem Header="{Binding RedoHeader}"
                          InputGesture="Ctrl+Shift+Z"
                          Command="{Binding RedoCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About Brickwork"
                          Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <dock:DockControl Layout="{Binding Layout}" />
    </DockPanel>
</Window>
