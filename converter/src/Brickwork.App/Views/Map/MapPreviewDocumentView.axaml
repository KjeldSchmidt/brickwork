<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Brickwork.App.Controls"
             xmlns:paz="using:Avalonia.Controls.PanAndZoom"
             xmlns:vm="using:Brickwork.App.ViewModels"
             x:Class="Brickwork.App.Views.Map.MapPreviewDocumentView"
             x:DataType="vm:MapPreviewDocumentViewModel"
             Focusable="True">
    <Grid Background="#FF1E1E1E">
        <TextBlock Text="Open a source map to preview it."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Opacity="0.6"
                   IsVisible="{Binding ShowPlaceholder}" />

        <paz:ZoomBorder x:Name="MapZoom"
                        IsVisible="{Binding HasMap}"
                        ClipToBounds="True"
                        Stretch="None"
                        Focusable="True"
                        PanButton="Right"
                        EnableZoom="True"
                        EnablePan="True"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
            <Grid Width="{Binding PreviewWidth}"
                  Height="{Binding PreviewHeight}">
                <controls:MapViewportControl x:Name="MapViewport"
                                             Map="{Binding Map}"
                                             ContentRevision="{Binding ContentRevision}"
                                             HighlightRevision="{Binding HighlightRevision}"
                                             SelectedWallEntityIds="{Binding SelectedWallEntityIds}"
                                             FocusedWallEntityId="{Binding FocusedWallEntityId}"
                                             FocusedPortal="{Binding FocusedPortal}"
                                             HoveredWallEntityId="{Binding HoveredWallEntityId}"
                                             HoveredPortal="{Binding HoveredPortal}"
                                             Width="{Binding PreviewWidth}"
                                             Height="{Binding PreviewHeight}" />
                <Canvas x:Name="MarqueeLayer"
                        IsHitTestVisible="False">
                    <Rectangle x:Name="MarqueeRect"
                               Stroke="#3B82F6"
                               StrokeThickness="1"
                               Fill="#403B82F6"
                               IsVisible="False" />
                </Canvas>
            </Grid>
        </paz:ZoomBorder>
    </Grid>
</UserControl>
