<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Brickwork.App.ViewModels"
        x:Class="Brickwork.App.Views.Dialogs.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Title="Settings"
        Width="840"
        Height="420"
        MinWidth="720"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
    <Window.Styles>
        <Style Selector="Button.settings-nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#C8D0DC" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.settings-nav /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.settings-nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#353945" />
            <Setter Property="Foreground" Value="#E8EEF5" />
        </Style>
        <Style Selector="Button.settings-nav:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#3D4452" />
        </Style>
        <Style Selector="Button.settings-nav.active">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.settings-nav.active /template/ ContentPresenter">
            <Setter Property="Background" Value="#3D4656" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.settings-nav.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4A5364" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="160,*">
        <Border Background="#252830"
                BorderBrush="#4A5364"
                BorderThickness="0,0,1,0"
                Padding="8">
            <StackPanel Spacing="2">
                <Button Content="Import"
                        Classes="settings-nav"
                        Classes.active="{Binding IsImportSelected}"
                        Command="{Binding SelectImportCommand}" />
                <Button Content="Export"
                        Classes="settings-nav"
                        Classes.active="{Binding IsExportSelected}"
                        Command="{Binding SelectExportCommand}" />
                <Button Content="General"
                        Classes="settings-nav"
                        Classes.active="{Binding IsGeneralSelected}"
                        Command="{Binding SelectGeneralCommand}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1"
                      Margin="16"
                      VerticalScrollBarVisibility="Auto">
            <Panel>
                <StackPanel Spacing="12" IsVisible="{Binding IsImportSelected}">
                    <TextBlock Text="Import" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Wall simplification tolerance"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Applied when opening a source map. Lower values keep more detail; higher values remove more noise."
                               TextWrapping="Wrap"
                               Opacity="0.75" />
                    <NumericUpDown Minimum="0"
                                   Maximum="500"
                                   Increment="1"
                                   FormatString="0.##"
                                   Value="{Binding WallSimplificationTolerance}"
                                   HorizontalAlignment="Left"
                                   Width="160" />
                    <TextBlock Text="Region Detection"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0" />
                    <TextBlock Text="When opening an Inkarnate map, closed paths that look like regions can be imported as regions instead of walls."
                               TextWrapping="Wrap"
                               Opacity="0.75" />
                    <CheckBox Content="Closed color paths (not texture/stamp)"
                              IsChecked="{Binding DetectRegionsFromColorPaths}" />
                    <CheckBox Content="Paths in region-named layers or groups"
                              IsChecked="{Binding DetectRegionsFromNamedContainers}" />
                    <CheckBox Content="Paths with region-like names"
                              IsChecked="{Binding DetectRegionsFromPathNames}" />
                </StackPanel>

                <StackPanel Spacing="12" IsVisible="{Binding IsExportSelected}">
                    <TextBlock Text="Export" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Foundry maps path"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Folder under Foundry's Data directory where map images live. Used as the base for background.src in Foundry exports (e.g. maps/my-map.webp)."
                               TextWrapping="Wrap"
                               Opacity="0.75" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding FoundryMapsPath}"
                                 Watermark="FoundryVTT/Data/maps"
                                 HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1"
                                Content="Browse…"
                                MinWidth="88"
                                Command="{Binding BrowseFoundryMapsPathCommand}" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="12" IsVisible="{Binding IsGeneralSelected}">
                    <TextBlock Text="General" FontSize="18" FontWeight="SemiBold" />
                    <CheckBox Content="Show debug panel"
                              IsChecked="{Binding ShowDebugPanel}" />
                    <TextBlock Text="When enabled, a Debug tab appears next to Walls and Regions with compatibility and source JSON tools."
                               TextWrapping="Wrap"
                               Opacity="0.75" />
                </StackPanel>
            </Panel>
        </ScrollViewer>
    </Grid>
</Window>
