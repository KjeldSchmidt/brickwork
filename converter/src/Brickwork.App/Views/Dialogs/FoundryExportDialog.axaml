<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Brickwork.App.Views.Dialogs.FoundryExportDialog"
        Title="Foundry export"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="20" Spacing="14">
        <TextBlock Text="Size of the Foundry scene. The map image and all walls, regions and lights are stretched to fill it."
                   TextWrapping="Wrap"
                   Opacity="0.85" />

        <StackPanel Spacing="6">
            <TextBlock Text="Grid squares" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <NumericUpDown x:Name="ColumnsBox"
                               Minimum="1" Maximum="2000" Increment="1" FormatString="0"
                               Width="120"
                               ValueChanged="OnColumnsChanged" />
                <TextBlock Text="×" VerticalAlignment="Center" />
                <NumericUpDown x:Name="RowsBox"
                               Minimum="1" Maximum="2000" Increment="1" FormatString="0"
                               Width="120"
                               ValueChanged="OnSizeChanged" />
            </StackPanel>
            <TextBlock x:Name="MapGridHint"
                       TextWrapping="Wrap"
                       Opacity="0.7"
                       FontSize="12" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="Pixels per square" FontWeight="SemiBold" />
            <NumericUpDown x:Name="PixelsBox"
                           Minimum="50" Maximum="1000" Increment="10" FormatString="0"
                           Width="120"
                           HorizontalAlignment="Left"
                           ValueChanged="OnSizeChanged" />
        </StackPanel>

        <TextBlock x:Name="SceneSizeText" Opacity="0.85" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Content="Cancel"
                    Click="OnCancelClick" />
            <Button Content="Export"
                    Classes="primary"
                    IsDefault="True"
                    Click="OnExportClick" />
        </StackPanel>
    </StackPanel>
</Window>
