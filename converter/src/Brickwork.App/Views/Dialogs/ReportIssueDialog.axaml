<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Brickwork.App.Views.Dialogs.ReportIssueDialog"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="20" Spacing="14">
        <TextBlock Text="Open a pre-filled GitHub issue in your browser."
                   TextWrapping="Wrap"
                   Opacity="0.85" />

        <StackPanel Spacing="6">
            <TextBlock Text="Issue title" FontWeight="SemiBold" />
            <TextBox x:Name="TitleBox" />
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock Text="Optional attachments" FontWeight="SemiBold" />
            <Button x:Name="ScreenshotButton"
                    Content="Save screenshot"
                    HorizontalAlignment="Left"
                    Click="OnSaveScreenshotClick" />
            <TextBlock Text="You are welcome to attach the source .ink file to the issue, but it is not required."
                       TextWrapping="Wrap"
                       Opacity="0.75"
                       FontSize="12" />
        </StackPanel>

        <TextBlock Text="Compatibility details are always included. Nothing is uploaded automatically."
                   TextWrapping="Wrap"
                   Opacity="0.7"
                   FontSize="12" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Content="Cancel"
                    Click="OnCancelClick" />
            <Button Content="Open GitHub issue"
                    Classes="primary"
                    Click="OnSubmitClick" />
        </StackPanel>
    </StackPanel>
</Window>
