<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Brickwork.App.Converters"
             xmlns:models="using:Brickwork.Core.Models"
             xmlns:vm="using:Brickwork.App.ViewModels"
             x:Class="Brickwork.App.Views.Panels.WallsToolView"
             x:DataType="vm:WallsToolViewModel"
             Classes="tool-panel"
             Focusable="True">
    <UserControl.Resources>
        <conv:WallLineTypeDisplayConverter x:Key="WallLineTypeDisplayConverter" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="TreeViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="TreeViewItem CheckBox">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ComboBox.wall-tree-type">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.wall-tree-rename">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer Classes="tool-panel-scroll">
        <Grid Margin="12">
        <TextBlock Text="{Binding EmptyMessage}"
                   Opacity="0.6"
                   TextWrapping="Wrap"
                   IsVisible="{Binding ShowEmptyMessage}" />

        <TreeView x:Name="WallsTree"
                  ItemsSource="{Binding Layers}"
                  SelectedItem="{Binding SelectedTreeItem, Mode=TwoWay}"
                  PointerExited="OnTreePointerExited"
                  IsVisible="{Binding HasLayers}">
            <TreeView.DataTemplates>
                <TreeDataTemplate DataType="vm:WallLayerNodeViewModel"
                                  ItemsSource="{Binding Children}">
                    <Border Padding="2,1"
                            HorizontalAlignment="Stretch"
                            CornerRadius="4"
                            Classes.wall-tree-highlight="{Binding IsTreeHighlighted}">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                            <CheckBox IsChecked="{Binding IsActive}"
                                      IsThreeState="True"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DisplayName}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding !IsRenaming}" />
                            <TextBox Classes="wall-tree-rename"
                                     Text="{Binding RenameText, Mode=TwoWay}"
                                     MinWidth="120"
                                     IsVisible="{Binding IsRenaming}"
                                     KeyDown="OnRenameBoxKeyDown"
                                     LostFocus="OnRenameBoxLostFocus" />
                        </StackPanel>
                    </Border>
                </TreeDataTemplate>

                <TreeDataTemplate DataType="vm:WallGroupNodeViewModel"
                                  ItemsSource="{Binding Children}">
                    <Border Padding="2,1"
                            HorizontalAlignment="Stretch"
                            CornerRadius="4"
                            Classes.wall-tree-highlight="{Binding IsTreeHighlighted}">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                            <CheckBox IsChecked="{Binding IsActive}"
                                      IsThreeState="True"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DisplayName}"
                                       FontWeight="Medium"
                                       Opacity="0.95"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding !IsRenaming}" />
                            <TextBox Classes="wall-tree-rename"
                                     Text="{Binding RenameText, Mode=TwoWay}"
                                     MinWidth="120"
                                     IsVisible="{Binding IsRenaming}"
                                     KeyDown="OnRenameBoxKeyDown"
                                     LostFocus="OnRenameBoxLostFocus" />
                        </StackPanel>
                    </Border>
                </TreeDataTemplate>

                <TreeDataTemplate DataType="vm:WallItemViewModel"
                                  ItemsSource="{Binding Portals}">
                    <Border Padding="2,1"
                            HorizontalAlignment="Stretch"
                            CornerRadius="4"
                            Classes.wall-tree-highlight="{Binding IsTreeHighlighted}">
                        <Grid HorizontalAlignment="Stretch"
                              ColumnDefinitions="Auto,*,Auto">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsActive}"
                                      VerticalAlignment="Center" />
                            <Panel Grid.Column="1" Margin="6,0">
                                <TextBlock Text="{Binding DisplayName}"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding !IsRenaming}" />
                                <TextBox Classes="wall-tree-rename"
                                         Text="{Binding RenameText, Mode=TwoWay}"
                                         IsVisible="{Binding IsRenaming}"
                                         KeyDown="OnRenameBoxKeyDown"
                                         LostFocus="OnRenameBoxLostFocus" />
                            </Panel>
                            <ComboBox Grid.Column="2"
                                      Classes="wall-tree-type"
                                      Width="118"
                                      ItemsSource="{Binding LineTypeOptions}"
                                      SelectedItem="{Binding LineType, Mode=TwoWay}"
                                      DropDownOpened="OnWallTypeDropDownOpened"
                                      DropDownClosed="OnWallTypeDropDownClosed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="models:WallLineType">
                                        <TextBlock Text="{Binding Converter={StaticResource WallLineTypeDisplayConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                </TreeDataTemplate>

                <DataTemplate DataType="vm:WallPortalItemViewModel">
                    <Border Padding="2,1"
                            Margin="20,0,0,0"
                            HorizontalAlignment="Stretch"
                            CornerRadius="4"
                            Classes.wall-tree-highlight="{Binding IsTreeHighlighted}">
                        <Grid HorizontalAlignment="Stretch"
                              ColumnDefinitions="Auto,*,Auto">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsActive}"
                                      VerticalAlignment="Center" />
                            <Panel Grid.Column="1" Margin="6,0">
                                <TextBlock Text="{Binding DisplayName}"
                                           VerticalAlignment="Center"
                                           Opacity="0.85"
                                           IsVisible="{Binding !IsRenaming}" />
                                <TextBox Classes="wall-tree-rename"
                                         Text="{Binding RenameText, Mode=TwoWay}"
                                         IsVisible="{Binding IsRenaming}"
                                         KeyDown="OnRenameBoxKeyDown"
                                         LostFocus="OnRenameBoxLostFocus" />
                            </Panel>
                            <ComboBox Grid.Column="2"
                                      Classes="wall-tree-type"
                                      Width="118"
                                      ItemsSource="{Binding LineTypeOptions}"
                                      SelectedItem="{Binding LineType, Mode=TwoWay}"
                                      DropDownOpened="OnWallTypeDropDownOpened"
                                      DropDownClosed="OnWallTypeDropDownClosed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="models:WallLineType">
                                        <TextBlock Text="{Binding Converter={StaticResource WallLineTypeDisplayConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                </DataTemplate>
            </TreeView.DataTemplates>
        </TreeView>
        </Grid>
    </ScrollViewer>
</UserControl>
