<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Brickwork.App.Converters"
             xmlns:models="using:Brickwork.Core.Models"
             xmlns:vm="using:Brickwork.App.ViewModels"
             x:Class="Brickwork.App.Views.Panels.RegionsToolView"
             x:DataType="vm:RegionsToolViewModel"
             Classes="tool-panel"
             Focusable="True">
    <UserControl.Resources>
        <conv:RegionTypeDisplayConverter x:Key="RegionTypeDisplayConverter" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="ListBoxItem CheckBox">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ComboBox.wall-tree-type">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.wall-tree-rename">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer Classes="tool-panel-scroll">
        <Grid Margin="12">
            <TextBlock Text="{Binding EmptyMessage}"
                       Opacity="0.6"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ShowEmptyMessage}" />

            <ListBox x:Name="RegionsList"
                     ItemsSource="{Binding Regions}"
                     SelectedItem="{Binding SelectedTreeItem, Mode=TwoWay}"
                     PointerExited="OnListPointerExited"
                     IsVisible="{Binding HasRegions}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:RegionItemViewModel">
                        <Border Padding="2,1"
                                HorizontalAlignment="Stretch"
                                CornerRadius="4"
                                Classes.wall-tree-highlight="{Binding IsTreeHighlighted}">
                            <Grid HorizontalAlignment="Stretch"
                                  ColumnDefinitions="Auto,*,Auto">
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsActive}"
                                          VerticalAlignment="Center" />
                                <Panel Grid.Column="1" Margin="6,0">
                                    <TextBlock Text="{Binding DisplayName}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !IsRenaming}" />
                                    <TextBox Classes="wall-tree-rename"
                                             Text="{Binding RenameText, Mode=TwoWay}"
                                             IsVisible="{Binding IsRenaming}"
                                             KeyDown="OnRenameBoxKeyDown"
                                             LostFocus="OnRenameBoxLostFocus" />
                                </Panel>
                                <ComboBox Grid.Column="2"
                                          Classes="wall-tree-type"
                                          Width="140"
                                          ItemsSource="{Binding RegionTypeOptions}"
                                          SelectedItem="{Binding RegionType, Mode=TwoWay}"
                                          DropDownOpened="OnTypeDropDownOpened"
                                          DropDownClosed="OnTypeDropDownClosed">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="models:RegionType">
                                            <TextBlock Text="{Binding Converter={StaticResource RegionTypeDisplayConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </ScrollViewer>
</UserControl>
