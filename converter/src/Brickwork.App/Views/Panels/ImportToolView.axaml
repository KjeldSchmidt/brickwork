<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             xmlns:vm="using:Brickwork.App.ViewModels"
             x:Class="Brickwork.App.Views.Panels.ImportToolView"
             x:DataType="vm:ImportToolViewModel"
             Classes="tool-panel">
    <ScrollViewer Classes="tool-panel-scroll">
        <StackPanel Margin="12" Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Button Grid.Column="0"
                        Content="Open Original Map"
                        Command="{Binding OpenSourceMapCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
                <Button Grid.Column="1"
                        Classes="muted settings-gear"
                        ToolTip.Tip="Import settings"
                        Command="{Binding OpenImportSettingsCommand}"
                        Width="36"
                        MinWidth="36"
                        Padding="0">
                    <iconPacks:PackIconFontAwesome6 Width="16"
                                                    Height="16"
                                                    Kind="GearSolid" />
                </Button>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Button Grid.Column="0"
                        Content="Export to VTT"
                        Command="{Binding ConvertCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />
                <Button Grid.Column="1"
                        Classes="muted settings-gear"
                        ToolTip.Tip="Export settings"
                        Command="{Binding OpenExportSettingsCommand}"
                        Width="36"
                        MinWidth="36"
                        Padding="0">
                    <iconPacks:PackIconFontAwesome6 Width="16"
                                                    Height="16"
                                                    Kind="GearSolid" />
                </Button>
            </Grid>

            <Border Padding="10"
                    CornerRadius="6"
                    Background="#33FFAA44"
                    IsVisible="{Binding ShowCompatibilityWarning}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding CompatibilityWarningMessage}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Report issue on GitHub"
                                Classes="accent"
                                Command="{Binding ReportCompatibilityIssueCommand}" />
                        <Button Content="Dismiss"
                                Classes="muted"
                                Command="{Binding DismissCompatibilityWarningCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Opacity="0.85" />

            <TextBlock Text="{Binding UnderlyingMapStatus}"
                       TextWrapping="Wrap"
                       Opacity="0.85"
                       IsVisible="{Binding ShowUnderlyingMapStatus}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
