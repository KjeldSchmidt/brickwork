<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Brickwork.App.ViewModels"
             x:Class="Brickwork.App.Views.Panels.ImportToolView"
             x:DataType="vm:ImportToolViewModel"
             Classes="tool-panel">
    <ScrollViewer Classes="tool-panel-scroll">
        <StackPanel Margin="12" Spacing="12">
        <Button Content="Open Original Map"
                Command="{Binding OpenSourceMapCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />

        <Button Content="Export to VTT"
                Command="{Binding ConvertCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" />

        <Border Padding="10"
                CornerRadius="6"
                Background="#33FFAA44"
                IsVisible="{Binding ShowCompatibilityWarning}">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding CompatibilityWarningMessage}"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Report issue on GitHub"
                            Classes="accent"
                            Command="{Binding ReportCompatibilityIssueCommand}" />
                    <Button Content="Dismiss"
                            Classes="muted"
                            Command="{Binding DismissCompatibilityWarningCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   Opacity="0.85" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
