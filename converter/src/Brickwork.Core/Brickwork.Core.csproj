<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Brickwork.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Built-in tree trunk adjustments; update by pasting from Settings > Import > "Copy tree-trunk library". -->
    <EmbeddedResource Include="..\..\..\resources\tree-trunks.json"
                      LogicalName="Brickwork.Core.TreeTrunkDefaults.json"
                      Link="Settings\tree-trunks.json" />
  </ItemGroup>

</Project>
