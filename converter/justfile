set windows-shell := ["powershell.exe", "-NoLogo", "-Command"]

# Apply dotnet format to the solution
fmt:
    dotnet format InkarnateTools.sln

# Verify formatting without writing files (for CI)
fmt-check:
    dotnet format InkarnateTools.sln --verify-no-changes

# Rebuild the converter solution
recompile:
    dotnet build InkarnateTools.sln

# Start the Avalonia GUI
gui:
    dotnet run --project src/InkarnateTools.App

# Rebuild and restart the GUI on file changes (incremental compile + auto-restart)
watch:
    dotnet watch run --project src/InkarnateTools.App

# Invoke the CLI (passthrough args after --)
cli *args:
    dotnet run --project src/InkarnateTools.Cli -- {{args}}
